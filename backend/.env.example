# Postgres (Neon / local) — e.g. postgresql+psycopg2://user:pass@host:5432/db?sslmode=require
# SQLite also works for local dev: sqlite:///./medrush.db
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/medrush?sslmode=require
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
OSRM_URL=https://router.project-osrm.org
MAP_PROVIDER=openstreetmap
SEED_DEMO_DATA=true
ENVIRONMENT=development